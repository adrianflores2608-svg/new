# Solana data provider — https://dev.helius.xyz (free tier works for a small watchlist)
HELIUS_API_KEY=

# Telegram bot — create one via @BotFather, then message it once and use
# https://api.telegram.org/bot<token>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often (seconds) to poll each tracked wallet for new transactions
POLL_INTERVAL_SECONDS=30

# How many distinct tracked wallets must buy the same token within the
# window below before a BUY signal fires (a floor — see conviction score below)
MIN_WALLETS_FOR_BUY_SIGNAL=2

# Conviction-weighted threshold: wallets discovered/ranked via /discover carry
# a realized-PnL-based weight (src/conviction.ts), so a buy from a proven
# wallet can count for more than one from an unranked wallet. Defaults to
# MIN_WALLETS_FOR_BUY_SIGNAL, which reproduces old flat-count behavior when
# no tracked wallet has ranking data (every wallet defaults to weight 1).
MIN_CONVICTION_SCORE_FOR_BUY_SIGNAL=2

# Rolling window (minutes) used to count "distinct wallets buying the same token"
BUY_SIGNAL_WINDOW_MINUTES=10

# If true, any tracked buyer selling a signaled token fires a SELL alert.
# If false, a SELL alert only fires once the majority of the original buyers have sold.
SELL_ALERT_ON_ANY_SELL=true

# --- Wallet discovery / ranking (npm run rank, or the /discover command) ---
# How many currently-trending pump.fun tokens to sample buyers from
RANK_SEED_TOKEN_LIMIT=15
# How many recent trades to pull per sampled token
RANK_TRADES_PER_SEED=50
# Cap on total distinct candidate wallets to score (bounds Helius API usage)
RANK_MAX_CANDIDATES=60
# Ignore candidates with fewer than this many closed (bought-then-sold) positions
RANK_MIN_CLOSED_POSITIONS=3
# How many top-ranked wallets to show/return
RANK_TOP_N=15
# How many pages of transaction history to sample per candidate wallet
RANK_HISTORY_PAGES=3
RANK_HISTORY_PAGE_SIZE=100
# How many candidate wallets to score in parallel
RANK_CONCURRENCY=4

# --- Rug/scam filtering (applied to every BUY signal before it's sent) ---
# "flag" = still alert, but with a visible warning + reasons
# "suppress" = don't alert at all if flagged
# "off" = skip rug checking entirely
RUG_CHECK_MODE=flag
RUG_REQUIRE_MINT_AUTHORITY_REVOKED=true
RUG_REQUIRE_FREEZE_AUTHORITY_REVOKED=true
# Flag if the token's creator wallet holds more than this % of total supply
RUG_MAX_CREATOR_HOLDING_PERCENT=15

# --- Risk-sized alerts & paper trading ---
# Hypothetical bankroll used only to size suggested positions / paper trades
RISK_BANKROLL_SOL=10
# Base position size as % of bankroll for an at-threshold signal
RISK_BASE_POSITION_PERCENT=3
# Hard cap on suggested position size as % of bankroll
RISK_MAX_POSITION_PERCENT=8
# Suggested stop-loss, as a % drop in market cap from entry
RISK_STOP_LOSS_PERCENT=35
